# Environment configuration for the Pegelonline-Dict MCP Server.

# Uvicorn params
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Application params (consumed by server.py)
# Upstream API base URLs (defaults shown; override only if proxying/mirroring).
PEGELONLINE_DICT_API_URL=https://dict-api.pegelonline.wsv.de
PEGELONLINE_API_URL=https://pegelonline.wsv.de/webservices/rest-api/v2

# NOTE: under uvicorn the log level is set in log-config.yaml, not here.
# LOG_LEVEL only affects the stdio runtime.
LOG_LEVEL=INFO
